# GitHub 用户名或组织名。仓库不在 songjiezhang 名下时修改这一项。
GHCR_OWNER=songjiezhang
GHCR_IMAGE_NAME=babyrecord
BABYRECORD_TAG=latest

# NAS 上提供给 Nginx Proxy Manager 的内部端口。
BABYRECORD_PORT=8080

# 必填。仅保存在 NAS 的 .env 中，不要提交真实值。
ACCESS_PIN=change-this-family-access-pin

# 以下值只用于构建 Android 安装包；网页端使用同源 /api 与 /sync。
EXPO_PUBLIC_DEFAULT_SYNC_ENDPOINT=
EXPO_PUBLIC_GITHUB_REPOSITORY=
EXPO_PUBLIC_GITHUB_PROXY_BASE=
